# 忽略所有 PyTorch 权重和检查点
checkpoints/
*.pt
*.pth
*.ckpt

# 忽略训练/推理输出目录（含 checkpoint、渲染图、点云等）
output/
logs/

# 忽略离线推理结果和临时生成的三维点云资产
results/
*.ply
*.png
*.npy

# X_debug 诊断工具：纳入 Git（脚本 / 报告），仅忽略其中间产物
!/X_debug/
!/X_debug/**
!/X_debug/**/*
/X_debug/**/*.ply
/X_debug/**/*.png
/X_debug/**/*.npy
/X_debug/**/*.pt
/X_debug/**/*.pth

# 忽略本地开发环境和缓存
.idea/
.vscode/
__pycache__/
*.pyc
.conda/
.cache/

# 屏蔽所有网页端运行时自动生成的 session 缓存文件夹
panovggt_session_*/
*.npz
*.glb
*.gltf
